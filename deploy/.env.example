# Copia este archivo como ".env" y ajusta los valores.
#   cp .env.example .env

# Puerto del host donde se publica la API (contenedor siempre usa 8880)
KOKORO_PORT=8880

# ------------------------------------------------------------------
# LÍMITES DE CPU Y RAM (se leen en docker-compose.yml -> deploy.resources)
# ------------------------------------------------------------------
KOKORO_CPUS=2.0
KOKORO_MEM_LIMIT=4g
KOKORO_CPUS_RESERVE=1.0
KOKORO_MEM_RESERVE=2g

# Nivel de log: INFO para servidor, DEBUG solo para depurar
API_LOG_LEVEL=INFO

# Solo para despliegue SIN INTERNET: usa la imagen local cargada con load-image.sh
# KOKORO_IMAGE=kokoro-tts:local
